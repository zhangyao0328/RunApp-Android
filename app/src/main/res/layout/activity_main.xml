<?xml version="1.0" encoding="utf-8"?>
<!-- 地图全屏铺底，状态与运动控制悬浮其上 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:id="@+id/trackPreviewContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/topStatusCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="@dimen/spacing_l"
        android:layout_marginTop="@dimen/spacing_m"
        android:background="@drawable/bg_overlay_card"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/spacing_l"
        android:paddingVertical="@dimen/spacing_m">
        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status_ready"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_body"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/tvDistance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_s"
            android:text="@string/distance_idle"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_display_l"
            android:fontFamily="@font/barlow_condensed_bold" />
        <TextView
            android:id="@+id/tvDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:text="@string/duration_idle"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body_s" />
        <TextView
            android:id="@+id/tvCadence"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:text="@string/cadence_idle"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_body_s"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/btnUser"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="@dimen/spacing_m"
        android:layout_marginEnd="@dimen/spacing_l"
        android:background="@drawable/bg_overlay_card"
        android:gravity="center"
        android:maxWidth="140dp"
        android:ellipsize="end"
        android:paddingHorizontal="@dimen/spacing_l"
        android:text="@string/auth_login_entry"
        android:textColor="@color/brand_secondary"
        android:textSize="@dimen/text_body"
        android:textStyle="bold" />

    <ImageButton
        android:id="@+id/btnLocate"
        android:layout_width="@dimen/map_button_size"
        android:layout_height="@dimen/map_button_size"
        android:layout_gravity="center_vertical|end"
        android:layout_marginEnd="@dimen/spacing_l"
        android:background="@drawable/bg_map_button"
        android:contentDescription="@string/desc_locate"
        android:elevation="4dp"
        android:padding="11dp"
        android:src="@drawable/ic_my_location" />

    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_bottom_scrim"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/spacing_l"
        android:paddingTop="@dimen/spacing_3xl"
        android:paddingBottom="@dimen/spacing_m">

        <LinearLayout
            android:id="@+id/sportSelector"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="@dimen/spacing_m"
            android:background="@drawable/bg_overlay_card"
            android:gravity="center"
            android:orientation="horizontal"
            android:padding="@dimen/spacing_xs">
            <TextView android:id="@+id/btnRun" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="@dimen/spacing_xs" android:background="@drawable/selector_chip_sport" android:clickable="true" android:focusable="true" android:gravity="center" android:text="@string/sport_run" android:textColor="@color/selector_sport_text" android:textSize="@dimen/text_body" android:textStyle="bold" />
            <TextView android:id="@+id/btnTrail" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="@dimen/spacing_xs" android:background="@drawable/selector_chip_sport" android:clickable="true" android:focusable="true" android:gravity="center" android:text="@string/sport_trail" android:textColor="@color/selector_sport_text" android:textSize="@dimen/text_body" android:textStyle="bold" />
            <TextView android:id="@+id/btnBike" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:layout_marginHorizontal="@dimen/spacing_xs" android:background="@drawable/selector_chip_sport" android:clickable="true" android:focusable="true" android:gravity="center" android:text="@string/sport_bike" android:textColor="@color/selector_sport_text" android:textSize="@dimen/text_body" android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/btnStart" style="@style/RunPulse.Button.Primary" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="@dimen/spacing_s" android:layout_weight="1" android:text="@string/sport_run_start" />
            <Button android:id="@+id/btnPause" style="@style/RunPulse.Button.Secondary" android:layout_width="0dp" android:layout_height="match_parent" android:layout_marginEnd="@dimen/spacing_s" android:layout_weight="1" android:text="@string/btn_pause" android:visibility="gone" />
            <Button
                android:id="@+id/btnStop"
                style="@style/RunPulse.Button.Danger"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:enabled="false"
                android:text="@string/btn_stop" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_xs"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <Button android:id="@+id/btnHistory" style="@style/RunPulse.Button.Text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/btn_history" />
            <Button android:id="@+id/btnBattery" style="@style/RunPulse.Button.Text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="@string/btn_battery_settings" />
        </LinearLayout>

        <Button android:id="@+id/btnImport" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/btn_import_test_data" android:visibility="gone" />
        <Button android:id="@+id/btnSync" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/btn_sync_to_cloud" android:visibility="gone" />
    </LinearLayout>
</FrameLayout>
