<?xml version="1.0" encoding="utf-8"?>
<!-- 登录页：深色运动风，品牌 Logo + 用户名/密码输入 + 登录按钮 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_auth_gradient"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/loginContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/spacing_2xl"
        android:paddingTop="80dp"
        android:paddingBottom="40dp">

        <!-- 品牌 Logo 区 -->
        <View
            android:layout_width="64dp"
            android:layout_height="6dp"
            android:background="@color/brand_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/barlow_condensed_bold"
            android:text="RUNPULSE"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_display_xl"
            android:letterSpacing="0.15" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/auth_login_subtitle"
            android:textColor="@color/text_muted"
            android:textSize="@dimen/text_body_l" />

        <!-- 用户名输入 -->
        <EditText
            android:id="@+id/etUsername"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="48dp"
            android:background="@drawable/bg_auth_input"
            android:hint="@string/auth_username_hint"
            android:inputType="text"
            android:maxLines="1"
            android:paddingHorizontal="16dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="@dimen/text_body_l" />

        <!-- 密码输入 -->
        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_auth_input"
            android:hint="@string/auth_password_hint"
            android:inputType="textPassword"
            android:maxLines="1"
            android:paddingHorizontal="16dp"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="@dimen/text_body_l" />

        <!-- 错误提示 -->
        <TextView
            android:id="@+id/tvError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/state_error"
            android:textSize="@dimen/text_body_s"
            android:visibility="gone" />

        <!-- 登录按钮 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp">

            <TextView
                android:id="@+id/btnLogin"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_auth_button"
                android:gravity="center"
                android:text="@string/auth_login"
                android:textColor="@color/on_brand_primary"
                android:textSize="@dimen/text_body_l"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/progressLogin"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/on_brand_primary"
                android:visibility="gone" />
        </FrameLayout>

        <!-- 注册链接 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/auth_no_account"
                android:textColor="@color/text_muted"
                android:textSize="@dimen/text_body" />

            <TextView
                android:id="@+id/btnGoRegister"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="@string/auth_go_register"
                android:textColor="@color/brand_secondary"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 游客入口 -->
        <TextView
            android:id="@+id/btnSkip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/auth_skip"
            android:textColor="@color/text_muted"
            android:textSize="@dimen/text_body" />

        <!-- 分割线 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:gravity="center"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/divider" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="16dp"
                android:text="@string/auth_other_login"
                android:textColor="@color/text_faint"
                android:textSize="@dimen/text_body_s" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/divider" />
        </LinearLayout>

        <!-- 第三方登录按钮 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:orientation="horizontal">

            <!-- 微信登录 -->
            <ImageView
                android:id="@+id/btnWechatLogin"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_auth_social_button"
                android:contentDescription="@string/auth_wechat_login"
                android:padding="12dp"
                android:src="@drawable/ic_wechat" />

            <!-- 一键登录 -->
            <ImageView
                android:id="@+id/btnPhoneLogin"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="24dp"
                android:background="@drawable/bg_auth_social_button"
                android:contentDescription="@string/auth_phone_login"
                android:padding="12dp"
                android:src="@drawable/ic_phone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
