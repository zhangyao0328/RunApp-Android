    <color name="bg_base">#0B1220</color>            <!-- 页面底色 -->
    <color name="bg_surface">#1F2937</color>         <!-- 卡片 / 内容块 -->
    <color name="bg_elevated">#313742</color>        <!-- 弹窗内卡 / 更高层级 -->
    <color name="bg_sheet">#141824</color>           <!-- 底部弹窗 -->
    <color name="bg_overlay">#B3000000</color>       <!-- 地图悬浮卡片 -->
    <color name="bg_input">#CC1F2937</color>         <!-- 输入框 -->
    <color name="bg_social_button">#1AFFFFFF</color> <!-- 第三方登录圆钮 -->
    <color name="bg_sport_icon">#33F97316</color>    <!-- 运动类型图标底（橙 20%） -->

    <!-- 文字 -->
    <color name="text_primary">#F8FAFC</color>
    <color name="text_secondary">#DDE4EC</color>
    <color name="text_muted">#94A3B8</color>
    <color name="text_faint">#64748B</color>

    <!-- 边框与分割线 -->
    <color name="border_subtle">#33FFFFFF</color>
